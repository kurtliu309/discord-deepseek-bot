# Copy to searxng.env (gitignored) and replace the value with a real random key:
#   py -c "import secrets; print('SEARXNG_SECRET=' + secrets.token_urlsafe(32))"
# SearXNG overrides server.secret_key in searxng/settings.yml with this variable.
# This file holds this one variable only — never the bot's .env.
SEARXNG_SECRET=change-me
