# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in with Notepad.
# docker compose passes these to bot + scheduler as environment variables (env_file: .env).
# The fetcher gets NONE of them. Never commit .env; never print it.
#
# v3: per-guild settings are NOT here any more -- persona, style, language, channel IDs,
# quiet channels, recap/topics on+channel+time, feed list, reply budget, jump-in chances
# and consent all live in data/guilds/<guild id>/config.yaml. Change them in Discord with
# /setup (owner only) or by editing that file; both bot and scheduler hot-reload it.
# The migration script reads the old v2 keys below for the last time.

# ---- secrets (required) ----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DEEPSEEK_API_KEY=

# ---- who ----
# Kurt's user ID: the only one who can DM the bot, use /feed and run /setup, and is
# never charged budget.
OWNER_USER_ID=

# ---- model / behaviour (global) ----
DEEPSEEK_MODEL=deepseek-flash
STATUS_MESSAGE=
CONTEXT_MESSAGES=12

# ---- scheduler (global) ----
# Time zone for every guild's configured times.
SCHED_TZ=Australia/Adelaide
