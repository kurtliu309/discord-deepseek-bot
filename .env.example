# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in with Notepad.
# docker compose passes these to bot + scheduler as environment variables (env_file: .env).
# The fetcher gets NONE of them. Never commit .env; never print it.

# ---- secrets (required) ----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DEEPSEEK_API_KEY=

# ---- who / where ----
# Kurt's user ID: the only one who can DM the bot, use /feed, and is never charged budget.
OWNER_USER_ID=
# Channels where the bot is completely silent (no replies, no jump-ins), e.g. #general.
BLOCKED_CHANNEL_IDS=

# ---- model / behaviour ----
DEEPSEEK_MODEL=deepseek-flash
# Persona. Leave empty to use prompts/default.txt (baked into the image). One line, \n = newline.
SYSTEM_PROMPT=
STATUS_MESSAGE=

# ---- reply budget + jump-ins ----
REPLY_BUDGET=50
BUDGET_RESET_TIME=09:00
RANDOM_CHANCE=0.03
BURST_COUNT=12
BURST_WINDOW_SECONDS=180
COOLDOWN_SECONDS=600
CONTEXT_MESSAGES=12

# ---- daily jobs (scheduler container) ----
POST_CHANNEL_ID=
SCHED_TZ=Australia/Adelaide
SUMMARY_TIME=22:00
TOPICS_TIME=09:00
TOPICS_COUNT=3
RECAP_CONTEXT=3
RECAP_KEEP_DAYS=10
