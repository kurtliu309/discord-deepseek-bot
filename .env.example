# Copy to .env (PowerShell: Copy-Item .env.example .env) and fill in with Notepad.
# docker compose passes these to the bot container as environment variables (env_file: .env).
# Never commit .env; never print it. The proxy settings are fixed in docker-compose.yml, not here.

# ---- secrets (required) ----
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DEEPSEEK_API_KEY=

# ---- access control ----
# Comma-separated Discord IDs (Developer Mode -> right click -> Copy ID).
# Empty list = no restriction in that category (llmcord semantics), so the bot refuses to
# start if BOTH lists are empty (unless ALLOW_PUBLIC=true).
ALLOWED_USER_IDS=
# Channel or category IDs in your server (threads count as their parent channel). Not applied to DMs.
ALLOWED_CHANNEL_IDS=
# DMs: allowed for the users in ALLOWED_USER_IDS. ALLOW_DMS=true requires ALLOWED_USER_IDS.
ALLOW_DMS=true
# Leave empty: with no admins nobody can use /model to switch models.
ADMIN_USER_IDS=
# Escape hatch: start with no allow-lists at all (open bot). Not recommended.
ALLOW_PUBLIC=false

# ---- model / behaviour ----
DEEPSEEK_MODEL=deepseek-flash
# Persona. Leave empty to use prompts/default.txt (baked into the image).
# To override inline: one line, use \n for line breaks, e.g.
# SYSTEM_PROMPT="You are a grumpy pirate.\nToday is {date}."
SYSTEM_PROMPT=
USE_PLAIN_RESPONSES=false
STATUS_MESSAGE=

# ---- daily jobs (scheduler container) ----
# Where the nightly recap and morning topics are posted (empty = first ALLOWED_CHANNEL_IDS).
POST_CHANNEL_ID=
SCHED_TZ=Australia/Adelaide
SUMMARY_TIME=22:00
TOPICS_TIME=09:00
TOPICS_COUNT=3
# How many earlier recaps to read back for the group's direction.
HISTORY_RECAPS=7
